<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KeyStudio">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The keyboard runs in its own process. Two reasons: force-stopping or
            crashing the Studio must never take the user's keyboard down with
            it, and the IME process then never loads the Compose runtime the
            Studio pulls in, keeping the keyboard's memory small. Profiles are
            already exchanged through files, so there is no shared state to lose.
        -->
        <service
            android:name=".ime.KeyStudioInputMethodService"
            android:exported="true"
            android:label="@string/ime_name"
            android:process=":ime"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>
</manifest>
